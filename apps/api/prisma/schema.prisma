generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id             String          @id @default(cuid())
  address        String          @unique
  username       String?
  profileImage   String?
  firstSeenAt    DateTime        @default(now())
  lastSyncedAt   DateTime?
  rawJson        Json?
  source         String?
  fetchedAt      DateTime?
  adapterVersion String?
  trades         Trade[]
  positions      Position[]
  metrics        WalletMetrics?
  readiness      WalletReadiness?
  ranking        WalletRanking?
  simulations    CopySimulation[]
}

model Market {
  id             String     @id @default(cuid())
  conditionId    String     @unique
  slug           String?
  title          String?
  category       String?
  endDate        DateTime?
  resolved       Boolean    @default(false)
  winningOutcome String?
  lastKnownPrice Decimal?   @db.Decimal(18, 8)
  eventId        String?
  eventSlug      String?
  rawJson        Json?
  source         String?
  fetchedAt      DateTime?
  adapterVersion String?
  trades         Trade[]
  positions      Position[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([resolved])
  @@index([eventId])
}

model Trade {
  id              String   @id @default(cuid())
  walletAddress   String
  marketId        String
  conditionId     String
  tokenId         String?
  outcome         String
  price           Decimal  @db.Decimal(18, 8)
  size            Decimal  @db.Decimal(18, 8)
  value           Decimal  @db.Decimal(18, 8)
  side            String?
  timestamp       DateTime
  transactionHash String?
  rawJson         Json?
  source          String?
  fetchedAt       DateTime?
  adapterVersion  String?
  wallet          Wallet   @relation(fields: [walletAddress], references: [address])
  market          Market   @relation(fields: [marketId], references: [conditionId])

  @@unique([walletAddress, transactionHash, conditionId, outcome, timestamp])
  @@index([walletAddress, timestamp])
  @@index([conditionId])
  @@index([tokenId])
}

model Position {
  id                String   @id @default(cuid())
  walletAddress     String
  marketId          String
  outcome           String
  currentShares     Decimal  @db.Decimal(18, 8)
  averageEntryPrice Decimal  @db.Decimal(18, 8)
  averageExitPrice  Decimal  @db.Decimal(18, 8)
  realizedPnl       Decimal  @db.Decimal(18, 8)
  unrealizedPnl     Decimal  @db.Decimal(18, 8)
  totalPnl          Decimal  @db.Decimal(18, 8)
  confidenceScore   Int
  eventId           String?
  negativeRisk      Boolean?
  redeemable        Boolean?
  mergeable         Boolean?
  curPrice          Decimal? @db.Decimal(18, 8)
  currentValue      Decimal? @db.Decimal(18, 8)
  cashPnl           Decimal? @db.Decimal(18, 8)
  percentPnl        Decimal? @db.Decimal(18, 8)
  snapshotSource    String?
  snapshotAt        DateTime?
  wallet            Wallet   @relation(fields: [walletAddress], references: [address])
  market            Market   @relation(fields: [marketId], references: [conditionId])

  @@unique([walletAddress, marketId, outcome])
  @@index([walletAddress])
  @@index([eventId])
}

model WalletMetrics {
  id                        String   @id @default(cuid())
  walletAddress             String   @unique
  totalPnl                  Decimal  @db.Decimal(18, 8)
  winrate                   Decimal  @db.Decimal(18, 8)
  volume                    Decimal  @db.Decimal(18, 8)
  drawdown                  Decimal  @db.Decimal(18, 8)
  tradeCount                Int
  realizedPnl               Decimal  @default(0) @db.Decimal(18, 8)
  unrealizedPnl             Decimal  @default(0) @db.Decimal(18, 8)
  roi                       Decimal  @default(0) @db.Decimal(18, 8)
  tradeWinrate              Decimal  @default(0) @db.Decimal(18, 8)
  marketWinrate             Decimal  @default(0) @db.Decimal(18, 8)
  resolvedMarketWinrate     Decimal  @default(0) @db.Decimal(18, 8)
  maxDrawdown               Decimal  @default(0) @db.Decimal(18, 8)
  currentDrawdown           Decimal  @default(0) @db.Decimal(18, 8)
  averageDrawdown           Decimal  @default(0) @db.Decimal(18, 8)
  longestWinStreak          Int      @default(0)
  longestLossStreak         Int      @default(0)
  bestTradeJson             Json?
  worstTradeJson            Json?
  profitDistributionJson    Json?
  winLossChartJson          Json?
  updatedAt                 DateTime @updatedAt
  wallet                    Wallet   @relation(fields: [walletAddress], references: [address])
}

model WalletReadiness {
  id                         String   @id @default(cuid())
  walletAddress              String   @unique
  readinessScore             Int
  dataCoverageScore          Int
  freshnessScore             Int
  activityScore              Int
  liquidityScore             Int
  positionSizeScore          Int
  activityCadenceJson        Json
  categoryExposureJson       Json
  oversizedTradesJson        Json
  oversizedTradeSummaryJson  Json
  warningsJson               Json
  configJson                 Json
  updatedAt                  DateTime @updatedAt
  wallet                     Wallet   @relation(fields: [walletAddress], references: [address])
}

model WalletRanking {
  id                       String   @id @default(cuid())
  walletAddress            String   @unique
  // Component scores are nullable: a null means the signal could not be computed (e.g. simulated
  // ROI / drawdown / delay tolerance before a copy simulation is run) and is shown as "n/a" rather
  // than a misleading 0. dataConfidence is always present.
  simulatedRoiScore        Int?
  realizedRoiScore         Int?
  drawdownScore            Int?
  consistencyScore         Int?
  recentPerformanceScore   Int?
  liquidityScore           Int?
  delayToleranceScore      Int?
  activityScore            Int?
  categoryFocusScore       Int?
  dataConfidenceScore      Int
  oversizedRiskScore       Int?
  finalScore               Int
  classification           String
  warningsJson             Json
  weightsVersion           String
  inputProfileJson         Json
  updatedAt                DateTime @updatedAt
  wallet                   Wallet   @relation(fields: [walletAddress], references: [address])

  @@index([finalScore])
}

model CopySimulation {
  id            String   @id @default(cuid())
  walletAddress String
  settingsJson  Json
  resultJson    Json
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])
}

model SyncJob {
  id            String   @id @default(cuid())
  walletAddress String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress])
  @@index([status])
}
