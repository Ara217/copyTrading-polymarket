{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "paths": {
      "@polyand/shared": ["../../packages/shared/dist/index.d.ts"],
      "@polyand/types": ["../../packages/types/dist/index.d.ts"],
      "@polyand/analytics": ["../../packages/analytics/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
